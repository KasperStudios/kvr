{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "KVR - spatial OS inside Minecraft: floating 3D windows, hardware tiers, energy and a QuickJS app runtime.",
  "authors": [
    "Kasperenok"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kasperstudios.kvr.fabric.KVRFabric"
    ],
    "client": [
      "com.kasperstudios.kvr.fabric.KVRFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft}"
  },
  "mixins": [
    "kvr-spatial.mixins.json",
    "kvr-power.mixins.json"
  ]
}
